# Copy to /etc/vangers-server.env on the VPS (install.sh does this) and edit.
# No secrets here: the server has no passwords or keys.

# Main TCP port of the game server (passed as /p<port>).
VANGERS_PORT=2197
# Extra switches: /s = write VangersServer.log, /b- = no UDP broadcast (useless on the internet),
# /l = keep empty games, /t<sec> = exit after N seconds without clients (do not use under systemd).
VANGERS_ARGS="/s /b-"
# How many daily Rating.lst backups to keep.
BACKUP_KEEP=14
